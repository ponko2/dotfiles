amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

steps {
  ["actionlint"] = Builtins.actionlint
  ["editorconfig_checker"] = Builtins.editorconfig_checker
  ["ghalint_action"] = Builtins.ghalint_action
  ["ghalint_workflow"] = Builtins.ghalint_workflow
  ["luacheck"] = Builtins.luacheck
  ["oxfmt"] = Builtins.oxfmt
  ["selene"] = Builtins.selene
  ["stylua"] = Builtins.stylua
  ["yamllint"] = Builtins.yamllint
  ["zizmor"] = Builtins.zizmor
}

hooks {
  ["commit-msg"] {
    steps {
      ["commitlint"] {
        check = "commitlint --edit {{commit_msg_file}}"
      }
    }
  }
}
