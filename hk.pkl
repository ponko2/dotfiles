amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"

steps {
  ["editorconfig_checker"] = Builtins.editorconfig_checker
  ["jactionlint"] = Builtins.jactionlint
  ["luacheck"] = Builtins.luacheck
  ["luals"] {
    types = List("lua")
    check = new CommandSpec {
      command = new Command { argv = List("lua-language-server", "--check", ".") }
      effect = "read"
    }
  }
  ["mise"] = Builtins.mise
  ["oxfmt"] = Builtins.oxfmt
  ["ryl"] = Builtins.ryl
  ["ryl_format"] = Builtins.ryl_format
  ["selene"] = Builtins.selene
  ["shellcheck"] = Builtins.shellcheck
  ["shfmt"] = Builtins.shfmt
  ["stylua"] = Builtins.stylua
}

hooks {
  ["commit-msg"] {
    steps {
      ["commitlint"] {
        check = "commitlint --edit {{commit_msg_file}}"
      }
    }
  }
}
