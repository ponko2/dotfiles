amends "package://github.com/jdx/hk/releases/download/v2.1.0/hk@2.1.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.1.0/hk@2.1.0#/Builtins.pkl"

steps {
  ["actionlint"] = Builtins.actionlint
  ["editorconfig_checker"] = Builtins.editorconfig_checker
  ["ghalint_action"] = Builtins.ghalint_action
  ["ghalint_workflow"] = Builtins.ghalint_workflow
  ["luacheck"] = Builtins.luacheck
  ["luals"] {
    types = List("lua")
    check = new CommandSpec {
      command = new Command { argv = List("lua-language-server", "--check", ".") }
      effect = "read"
    }
  }
  ["oxfmt"] = Builtins.oxfmt
  ["ryl"] = Builtins.ryl
  ["selene"] = Builtins.selene
  ["shellcheck"] = (Builtins.shellcheck) {
    match_any =
      Builtins.shellcheck.match_any
        + List(new FileSelector {
          glob =
            List(
              "home/.local/bin/rfv",
              "home/.local/bin/update-system",
              "home/.nbrc",
            )
        })
  }
  ["shfmt"] = (Builtins.shfmt) {
    match_any =
      Builtins.shfmt.match_any
        + List(new FileSelector {
          glob =
            List(
              "home/.local/bin/rfv",
              "home/.local/bin/update-system",
              "home/.nbrc",
              "home/.zprofile",
              "home/.zshenv",
              "home/.zshrc",
            )
        })
  }
  ["stylua"] = Builtins.stylua
  ["zizmor"] = Builtins.zizmor
}

hooks {
  ["commit-msg"] {
    steps {
      ["commitlint"] {
        check = "commitlint --edit {{commit_msg_file}}"
      }
    }
  }
}
