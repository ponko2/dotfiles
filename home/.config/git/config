[user]
	name = Takahito Nakano
	email = kano@ponko2.jp
	signingKey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIM1vRbMLXd3C3xhcfdbRtrazLjbJUJbPrQGIIr5FdSHo
[core]
	editor = nvim --clean -c 'set enc=utf-8 cb+=unnamed'
	precomposeUnicode = true
	quotePath = false
[add.interactive]
	useBuiltin = false
[branch]
	sort = -committerdate
[commit]
	gpgSign = true
	verbose = true
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[diff]
	algorithm = histogram
	colorMoved = default
	colorMovedWS = allow-indentation-change
	indentHeuristic = true
[fetch]
	prune = true
	pruneTags = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	process = git-lfs filter-process
	required = true
	smudge = git-lfs smudge -- %f
[ghq]
	root = ~/src
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[grep]
	fullName = true
[hook "hk-commit-msg"]
	command = test \"${HK:-1}\" = \"0\" || hk run commit-msg --from-hook
	event = commit-msg
[hook "hk-pre-commit"]
	command = test \"${HK:-1}\" = \"0\" || hk run pre-commit --from-hook --staged
	event = pre-commit
[hook "hk-pre-push"]
	command = test \"${HK:-1}\" = \"0\" || hk run pre-push --from-hook
	event = pre-push
[hook "hk-prepare-commit-msg"]
	command = test \"${HK:-1}\" = \"0\" || hk run prepare-commit-msg --from-hook
	event = prepare-commit-msg
[init]
	defaultBranch = main
[log]
	date = iso8601-local
[merge]
	conflictStyle = zdiff3
	ff = false
[pager]
	branch = false
[pull]
	rebase = merges
[push]
	autoSetupRemote = true
	default = current
	followTags = true
[rebase]
	abbreviateCommands = true
	autoSquash = true
	autoStash = true
	missingCommitsCheck = error
[rerere]
	enabled = true
[stash]
	showPatch = true
[status]
	showUntrackedFiles = all
[tag]
	sort = version:refname
[include]
	path = ~/.config/git/env/.gitconfig
