#!/usr/bin/env bash

set -euo pipefail

# mise
mise self-update --yes
mise -C ~/.dotfiles bootstrap --yes --update
mise -C ~/.dotfiles bootstrap packages upgrade --yes
mise -C ~/.dotfiles upgrade --yes
mise -C ~/.dotfiles lock
mise -C ~/.dotfiles lock --global
mise prune --yes

# Homebrew
brew update --auto-update
brew upgrade --fetch-HEAD

# Yazi
ya pkg upgrade

# Zsh
sheldon lock --update
rm -rf "${XDG_CACHE_HOME:-$HOME/.cache}/zsh" && mkdir -p "$_"
zsh -c 'autoload -Uz compinit; compinit -d "$XDG_CACHE_HOME/zsh/zcompdump-$ZSH_VERSION"'

# Neovim
nvim --headless "+Lazy! update" +qa
