#!/usr/bin/env bash

set -euo pipefail

if command -v darwin-rebuild >/dev/null; then
  # Nix
  NIX_CONFIG="access-tokens = github.com=$(gh auth token)" nix flake update --flake ~/.dotfiles
  nh darwin switch
  nh clean all --keep 3 --keep-since 4d
else
  # Homebrew
  brew update --auto-update
  brew upgrade --fetch-HEAD
  # mise
  mise self-update --yes
  mise bootstrap --yes --update -C ~/.dotfiles
  mise upgrade --yes
  mise prune --yes
fi

# Yazi
ya pkg upgrade

# Zsh
sheldon lock --update
rm -rf "${XDG_CACHE_HOME:-$HOME/.cache}/zsh" && mkdir -p "$_"
zsh -c 'autoload -Uz compinit; compinit -d "$XDG_CACHE_HOME/zsh/zcompdump-$ZSH_VERSION"'

# Neovim
nvim --headless "+Lazy! update" +qa
