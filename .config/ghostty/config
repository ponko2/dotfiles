font-family = "UDEV Gothic"
font-feature = -calt
font-feature = -liga
font-feature = -dlig
font-size = 16
theme = Gruvbox Dark
mouse-hide-while-typing = true
background-opacity = 0.8
background-blur = true
initial-command = ${SHELL:-zsh} -lc 'command -v herdr >/dev/null 2>&1 && exec herdr; exec ${SHELL:-zsh} -l'
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify
keybind = ctrl+[=text:\x1B
keybind = ctrl+i=text:\x09
keybind = ctrl+m=text:\x0D
keybind = ctrl+shift+tab=text:\x1b[24~p
keybind = ctrl+tab=text:\x1b[24~n
keybind = global:super+ctrl+backquote=toggle_quick_terminal
keybind = super+[=text:\x1b[24~\x1b[Z
keybind = super+]=text:\x1b[24~\x09
keybind = super+alt+w=text:\x1b[24~X
keybind = super+b=text:\x1b[24~
keybind = super+ctrl+[=text:\x1b[24~\x10
keybind = super+ctrl+]=text:\x1b[24~\x0e
keybind = super+ctrl+shift+[=text:\x1b[24~\x1b[112;6u
keybind = super+ctrl+shift+]=text:\x1b[24~\x1b[110;6u
keybind = super+d=text:\x1b[24~v
keybind = super+digit_1=text:\x1b[24~1
keybind = super+digit_2=text:\x1b[24~2
keybind = super+digit_3=text:\x1b[24~3
keybind = super+digit_4=text:\x1b[24~4
keybind = super+digit_5=text:\x1b[24~5
keybind = super+digit_6=text:\x1b[24~6
keybind = super+digit_7=text:\x1b[24~7
keybind = super+digit_8=text:\x1b[24~8
keybind = super+digit_9=text:\x1b[24~9
keybind = super+n=text:\x1b[24~N
keybind = super+shift+[=text:\x1b[24~p
keybind = super+shift+]=text:\x1b[24~n
keybind = super+shift+d=text:\x1b[24~-
keybind = super+shift+enter=text:\x1b[24~z
keybind = super+shift+w=text:\x1b[24~D
keybind = super+t=text:\x1b[24~c
keybind = super+w=text:\x1b[24~x
window-padding-x = 8
window-padding-balance = true
window-inherit-working-directory = false
tab-inherit-working-directory = false
split-inherit-working-directory = true
confirm-close-surface = false
quit-after-last-window-closed = true
quick-terminal-position = right
quick-terminal-size = 40%
quick-terminal-autohide = false
macos-dock-drop-behavior = new-window
macos-option-as-alt = true
